{
  "name": "sinkker",
  "version": "2.0.0",
  "private": true,
  "description": "Self-hosted DNS sinkhole on Cloudflare Workers — block ads, trackers and malware network-wide from a dashboard, with no server to run.",
  "license": "Unlicense",
  "type": "module",
  "main": "worker.js",
  "keywords": [
    "dns",
    "dns-sinkhole",
    "doh",
    "dns-over-https",
    "adblock",
    "pi-hole-alternative",
    "cloudflare-workers",
    "privacy",
    "malware-blocking"
  ],
  "homepage": "https://github.com/Stillman7896/sinkker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stillman7896/sinkker.git"
  },
  "bugs": {
    "url": "https://github.com/Stillman7896/sinkker/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 \"test/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "fix": "eslint . --fix",
    "ui:dev": "vite --config ui/vite.config.js --host",
    "ui:build": "vite build --config ui/vite.config.js",
    "ui:preview": "vite preview --config ui/vite.config.js",
    "verify:assets": "npm run ui:build && node tools/check-inline.js && git diff --exit-code -- assets",
    "screenshots": "node tools/screenshots.js",
    "brand": "node tools/render-brand.js",
    "deploy": "wrangler deploy"
  },
  "cloudflare": {
    "bindings": {
      "DASHBOARD_PASSWORD": {
        "description": "Password for the dashboard at `/dashboard`. Leave blank to run as a plain DNS resolver without the dashboard."
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@unocss/reset": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "17.13.0",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "unocss": "^66.11.0",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1"
  }
}
