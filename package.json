{
  "name": "dns-filter-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "worker.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 \"test/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "fix": "eslint . --fix",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "7.0.2"
  }
}
