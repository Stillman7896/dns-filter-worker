{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "*.js",
    "test/**/*.js",
    "types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "assets",
    "tools"
  ]
}
